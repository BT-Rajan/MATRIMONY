# Copy this file to .env and fill in real values. Never commit .env itself.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=matrimony
DB_USER=matri
DB_PASS=change-me

# Leave SMTP_HOST empty during local development to fall back to PHP's
# mail() (or just have emails logged to the PHP error log if no MTA
# is configured on this machine).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=கார்காத்தார் மங்கள சந்திப்பு

# Only needed if the frontend is served from a different origin than the
# api/ folder (e.g. during local dev with a separate static server).
# Leave as * for same-origin deployments (the normal case).
CORS_ORIGIN=*
