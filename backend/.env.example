APP_ENV=local

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=karkathar_matrimony
DB_USER=karkathar_app
DB_PASS=
DB_CHARSET=utf8mb4

JWT_SECRET=change-this-to-a-long-random-value
JWT_TTL_SECONDS=28800

CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Notifications (Pass 8) ---
# All three channels default to disabled; the app works fully without any
# of them configured (notifications are just logged as "skipped"). See
# docs/SETUP.md "Notifications" section for how to wire in a real provider.

MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Karkathar Mangala Sandhippu

SMS_ENABLED=false
SMS_API_URL=
SMS_API_METHOD=POST
SMS_API_HEADERS={"Content-Type":"application/json"}
SMS_API_BODY_TEMPLATE={"to":"{{phone}}","message":"{{message}}"}

WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_API_METHOD=POST
WHATSAPP_API_HEADERS={"Content-Type":"application/json"}
WHATSAPP_API_BODY_TEMPLATE={"to":"{{phone}}","message":"{{message}}"}
